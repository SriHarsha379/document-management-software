generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id             String          @id @default(uuid())
  name           String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  branches       Branch[]
  lrs            Lr[]
  officers       Officer[]
  parties        Party[]
  products       Product[]
  transporters   Transporter[]
  users          User[]
  workingCentres WorkingCentre[]

  @@map("companies")
}

model Branch {
  id               String             @id @default(uuid())
  name             String
  companyId        String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  company          Company            @relation(fields: [companyId], references: [id])
  lrs              Lr[]
  userBranchAccess UserBranchAccess[]
  workingCentres   WorkingCentre[]

  @@map("branches")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String
  name              String
  companyId         String
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  userBranchAccess  UserBranchAccess[]
  userRoles         UserRole[]
  userSourceAccess  UserSourceAccess[]
  uploadedDocuments Document[]         @relation("DocumentUploader")
  company           Company            @relation(fields: [companyId], references: [id])

  @@map("users")
}

model Role {
  id              String           @id @default(uuid())
  key             String           @unique
  name            String
  isSystem        Boolean          @default(false)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  key             String           @unique
  resource        String
  action          String
  description     String?
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserBranchAccess {
  userId   String
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branch_access")
}

model UserSourceAccess {
  userId String
  source String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, source])
  @@map("user_source_access")
}

model Lr {
  id                  String               @id @default(uuid())
  serialNo            Int?
  lrNo                String
  lrDate              String?
  loadingSlipNo       String?
  companyInvoiceDate  String?
  companyInvoiceNo    String?
  companyEwayBillNo   String?
  principalCompany    String?
  billToParty         String?
  shipToParty         String?
  deliveryDestination String?
  tpt                 String?
  orderType           String?
  productName         String?
  vehicleNo           String?
  quantityInBags      Float?
  quantityInMt        Float?
  tollCharges         Float?
  weighmentCharges    Float?
  unloadingAtSite     Float?
  driverBhatta        Float?
  dayOpeningKm        Float?
  dayClosingKm        Float?
  totalRunningKm      Float?
  fuelPerKm           Float?
  fuelAmount          Float?
  grandTotal          Float?
  tptCode             String?
  transporterName     String?
  driverName          String?
  driverBillNo        String?
  billDate            String?
  billNo              String?
  billAmount          Float?
  invoiceNo           String?
  status              String               @default("DRAFT")
  consignor           String?
  consignee           String?
  date                String?
  createdBy           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  companyId           String
  branchId            String
  driverCellNo        String?
  ewayBillDate        String?
  approvedDestination String?
  orderNo             String?
  workingCenter       String?
  depotPlantCode      String?
  source              String               @default("INTERNAL")
  sealNo              String?
  outTime             String?
  // ── Auto-reconciliation (computed from linked TOLL / WEIGHMENT documents) ──
  // Never hand-edited by users; recomputed every time a document is linked
  // or unlinked. See services/reconciliationService.ts.
  autoTollAmount        Float?
  originNetWeightKg     Float?
  destinationNetWeightKg Float?
  weightVariancePct     Float?
  reconciliationIssues  String?
  reconciledAt          DateTime?
  documentLinks       DocumentLinkRecord[]
  uploadedDocuments   Document[]
  branch              Branch               @relation(fields: [branchId], references: [id])
  company             Company              @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([lrNo])
  @@index([vehicleNo])
  @@index([date])
  @@index([serialNo])
  @@index([sealNo])
  @@map("lrs")
}

model DocumentGroup {
  id                 String                 @id @default(uuid())
  vehicleNo          String
  date               String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  bundles            DocumentBundle[]
  documents          Document[]
  driverUploadedDocs DriverUploadDocument[]

  @@unique([vehicleNo, date])
  @@map("document_groups")
}

model Document {
  id                 String               @id @default(uuid())
  type               DocumentType
  status             DocumentStatus       @default(PENDING_REVIEW)
  originalFilename   String
  rawFilePath        String
  mimeType           String
  uploadedAt         DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  groupId            String?
  lrId               String?
  lrDocumentCategory LrDocumentCategory?
  uploadedById       String?
  sourceDocumentId   String?
  pageNumber         Int?
  bundleItems        BundleItem[]
  documentLinks      DocumentLinkRecord[]
  group              DocumentGroup?       @relation(fields: [groupId], references: [id])
  lr                 Lr?                  @relation(fields: [lrId], references: [id], onDelete: Cascade)
  uploadedBy         User?                @relation("DocumentUploader", fields: [uploadedById], references: [id])
  extractedData      ExtractedData?

  @@index([type])
  @@index([status])
  @@index([uploadedAt])
  @@index([sourceDocumentId])
  @@index([lrId])
  @@index([lrDocumentCategory])
  @@index([uploadedById])
  @@map("documents")
}

model ExtractedData {
  id                  String    @id @default(uuid())
  documentId          String    @unique
  lrNo                String?
  invoiceNo           String?
  vehicleNo           String?
  quantity            String?
  date                String?
  partyNames          String?
  tollAmount          String?
  weightInfo          String?
  transporter         String?
  billToParty         String?
  shipToParty         String?
  principalCompany    String?
  branchName          String?
  loadingSlipNo       String?
  companyInvoiceNo    String?
  companyInvoiceDate  String?
  companyEwayBillNo   String?
  deliveryDestination String?
  productName         String?
  transporterName     String?
  orderType           String?
  tptCode             String?
  quantityInMt        Float?
  quantityInBags      Float?
  driverName          String?
  driverCellNo        String?
  ewayBillDate        String?
  approvedDestination String?
  orderNo             String?
  workingCenter       String?
  depotPlantCode      String?
  source              String?
  sealNo              String?
  documentTime        String?
  rawOcrResponse      String
  confidence          Float?
  ocrProcessedAt      DateTime  @default(now())
  userReviewed        Boolean   @default(false)
  reviewedAt          DateTime?
  userEdits           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  document            Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([vehicleNo])
  @@index([lrNo])
  @@index([invoiceNo])
  @@index([date])
  @@index([transporter])
  @@index([reviewedAt])
  @@index([sealNo])
  @@map("extracted_data")
}

model ExtractionProfile {
  id               String       @id @default(uuid())
  profileKey       String       @unique
  documentType     DocumentType
  principalCompany String?
  branchName       String?
  transporterName  String?
  profileData      String
  samplesCount     Int          @default(1)
  successfulSaves  Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  lastUsedAt       DateTime     @default(now())

  @@index([documentType])
  @@index([principalCompany])
  @@index([branchName])
  @@index([transporterName])
  @@map("extraction_profiles")
}

model DocumentBundle {
  id            String        @id @default(uuid())
  recipientType RecipientType
  status        BundleStatus  @default(DRAFT)
  notes         String?
  groupId       String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         BundleItem[]
  dispatchLogs  DispatchLog[]
  group         DocumentGroup @relation(fields: [groupId], references: [id])

  @@map("document_bundles")
}

model BundleItem {
  id         String         @id @default(uuid())
  bundleId   String
  documentId String
  isOverride Boolean        @default(false)
  bundle     DocumentBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  document   Document       @relation(fields: [documentId], references: [id])

  @@unique([bundleId, documentId])
  @@map("bundle_items")
}

model DispatchLog {
  id          String          @id @default(uuid())
  bundleId    String
  channel     DispatchChannel
  recipient   String
  ccRecipient String?
  message     String
  status      DispatchStatus  @default(PENDING)
  errorMsg    String?
  sentAt      DateTime        @default(now())
  bundle      DocumentBundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@map("dispatch_logs")
}

model TemporaryDriverAccess {
  id           String                 @id @default(uuid())
  phone        String                 @unique
  passwordHash String
  createdAt    DateTime               @default(now())
  expiresAt    DateTime
  lastLoginAt  DateTime?
  isRevoked    Boolean                @default(false)
  uploadedDocs DriverUploadDocument[]

  @@map("temporary_driver_accesses")
}

model DriverUploadDocument {
  id                 String                @id @default(uuid())
  docType            DriverDocType
  storageKey         String
  originalFilename   String
  mimeType           String
  uploadedAt         DateTime              @default(now())
  status             DriverUploadStatus    @default(PENDING_OCR)
  ocrText            String?
  ocrData            String?
  vehicleNumber      String?
  documentDate       String?
  linkedGroupId      String?
  tempDriverAccessId String
  linkedGroup        DocumentGroup?        @relation(fields: [linkedGroupId], references: [id])
  tempDriverAccess   TemporaryDriverAccess @relation(fields: [tempDriverAccessId], references: [id])

  @@map("driver_upload_documents")
}

model SavedFilter {
  id        String   @id @default(uuid())
  userId    String
  name      String
  filters   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("saved_filters")
}

model Transporter {
  id          String   @id @default(uuid())
  code        String
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  isActive    Boolean  @default(true)
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@index([companyId])
  @@index([isActive])
  @@map("transporters")
}

model Officer {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  role      String?
  isActive  Boolean  @default(true)
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([isActive])
  @@map("officers")
}

model Party {
  id                     String                 @id @default(uuid())
  code                   String
  name                   String
  contactPerson          String?
  phone                  String?
  email                  String?
  isBillToParty          Boolean                @default(true)
  isShipToParty          Boolean                @default(true)
  gstNo                  String?
  address                String?
  isActive               Boolean                @default(true)
  companyId              String
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  customerPortalAccesses CustomerPortalAccess[]
  company                Company                @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@index([companyId])
  @@index([isActive])
  @@map("parties")
}

model CustomerPortalAccess {
  id          String    @id @default(uuid())
  partyId     String
  loginEmail  String    @unique
  tokenHash   String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  lastLoginAt DateTime?
  isRevoked   Boolean   @default(false)
  party       Party     @relation(fields: [partyId], references: [id])

  @@map("customer_portal_accesses")
}

model Product {
  id        String   @id @default(uuid())
  name      String
  brand     String?
  category  String?
  unit      String?
  isActive  Boolean  @default(true)
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, name, brand])
  @@index([companyId])
  @@index([category])
  @@index([isActive])
  @@map("products")
}

model WorkingCentre {
  id        String   @id @default(uuid())
  code      String
  name      String
  address   String?
  isActive  Boolean  @default(true)
  branchId  String?
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch?  @relation(fields: [branchId], references: [id])
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@index([companyId])
  @@index([branchId])
  @@index([isActive])
  @@map("working_centres")
}

model CompanySettings {
  companyId      String  @id
  smtpFrom       String?
  whatsappFrom   String?
  defaultCCEmail String?
  defaultCCPhone String?

  @@map("company_settings")
}

model MessageTemplate {
  id              String             @id @default(uuid())
  companyId       String
  code            String
  name            String
  channel         CommChannel        @default(BOTH)
  subjectTemplate String?
  bodyTemplate    String
  isActive        Boolean            @default(true)
  isDefault       Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  jobs            CommunicationJob[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([isActive])
  @@map("message_templates")
}

model CommunicationJob {
  id           String                 @id @default(uuid())
  companyId    String
  bundleId     String?
  channel      CommChannel
  recipients   String
  templateId   String?
  templateVars String                 @default("{}")
  status       JobStatus              @default(QUEUED)
  priority     JobPriority            @default(NORMAL)
  scheduledAt  DateTime               @default(now())
  processedAt  DateTime?
  retryCount   Int                    @default(0)
  maxRetries   Int                    @default(3)
  lastError    String?
  notes        String?
  createdBy    String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  template     MessageTemplate?       @relation(fields: [templateId], references: [id])
  messages     CommunicationMessage[]

  @@index([companyId])
  @@index([status])
  @@index([scheduledAt])
  @@index([bundleId])
  @@map("communication_jobs")
}

model CommunicationMessage {
  id              String           @id @default(uuid())
  jobId           String
  channel         CommChannel
  recipient       String
  recipientName   String?
  isCC            Boolean          @default(false)
  renderedSubject String?
  renderedBody    String
  mediaUrls       String           @default("[]")
  status          MsgStatus        @default(PENDING)
  attemptCount    Int              @default(0)
  lastAttemptAt   DateTime?
  sentAt          DateTime?
  errorCode       String?
  errorMsg        String?
  externalId      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  job             CommunicationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
  @@index([recipient])
  @@map("communication_messages")
}

model DocumentLinkRecord {
  id            String   @id @default(uuid())
  documentId    String
  lrId          String
  matchedFields String
  confidence    Float    @default(0.5)
  isManual      Boolean  @default(false)
  linkedAt      DateTime @default(now())
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  lr            Lr       @relation(fields: [lrId], references: [id], onDelete: Cascade)

  @@unique([documentId, lrId])
  @@map("document_link_records")
}

enum DocumentType {
  LR
  INVOICE
  TOLL
  WEIGHMENT
  WEIGHMENT_PARTY
  WEIGHMENT_SITE
  EWAYBILL
  RECEIVING
  UNKNOWN
}

enum DocumentStatus {
  PENDING_OCR
  PENDING_REVIEW
  REVIEWED
  SAVED
}

enum LrDocumentCategory {
  LR_GENERATED
  ACKNOWLEDGED_INVOICE
  ACKNOWLEDGED_LR_COPY
  DEPOT_PLANT_WEIGHMENT_SLIP
  SITE_WEIGHMENT_SLIP
  TOLL_RECEIPT
  ADDITIONAL_ATTACHMENT_1
  ADDITIONAL_ATTACHMENT_2
}

enum RecipientType {
  ACCOUNTS
  PARTY
  TRANSPORTER
}

enum BundleStatus {
  DRAFT
  READY
  SENT
}

enum DispatchChannel {
  EMAIL
  WHATSAPP
}

enum DispatchStatus {
  PENDING
  SENT
  FAILED
}

enum DriverDocType {
  LR
  TOLL
  WEIGHMENT_SLIP
  WEIGHMENT_PARTY
  WEIGHMENT_SITE
  PARTY_ACK
}

enum DriverUploadStatus {
  PENDING_OCR
  PROCESSED
  UNLINKED
}

enum CommChannel {
  EMAIL
  WHATSAPP
  BOTH
}

enum JobStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
  CANCELLED
}

enum JobPriority {
  HIGH
  NORMAL
  LOW
}

enum MsgStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}