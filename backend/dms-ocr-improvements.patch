+  ADD COLUMN "destinationNetWeightKg" DOUBLE PRECISION,
+  ADD COLUMN "weightVariancePct" DOUBLE PRECISION,
+  ADD COLUMN "reconciliationIssues" TEXT,
+  ADD COLUMN "reconciledAt" TIMESTAMP(3);
